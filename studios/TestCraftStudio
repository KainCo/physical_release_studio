<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Physical Release Studio — Box & Inlay Studio</title>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111726;
      --border: #1f293d;
      --hover: #1a2336;
      --brand: #2563eb;
      --brand-accent: #a855f7;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
    }

    header {
      width: 100%;
      max-width: 1024px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: rgba(9, 13, 22, 0.9);
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .brand-title {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: white;
    }

    .brand-title i {
      font-size: 1.5rem;
      color: #3b82f6;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .lang-switcher {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2px;
      display: flex;
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 4px 10px;
      font-size: 0.75rem;
      font-weight: bold;
      font-family: 'JetBrains Mono', monospace;
      cursor: pointer;
      border-radius: 6px;
    }

    .lang-btn.active {
      background: var(--brand);
      color: white;
    }

    .btn-index {
      background: var(--card-bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: bold;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-index:hover {
      border-color: var(--brand);
    }

    .ui-container {
      width: 100%;
      max-width: 1024px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      margin-bottom: 24px;
    }

    .header-title {
      font-size: 1.4rem;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .sub-title {
      font-size: 0.8rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
      margin-bottom: 20px;
    }

    .option-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .option-card label {
      font-weight: bold;
      font-size: 0.85rem;
      color: var(--text);
    }

    .option-card select, .option-card input[type="file"] {
      padding: 8px 12px;
      font-size: 0.85rem;
      font-weight: bold;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      cursor: pointer;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      font-weight: bold;
      color: var(--text);
      cursor: pointer;
    }

    .btn-print {
      width: 100%;
      background: #10b981;
      color: white;
      padding: 14px;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }

    .btn-print:hover {
      background: #059669;
    }

    .preview-wrapper {
      display: flex;
      flex-direction: column;
      gap: 20px;
      align-items: center;
      width: 100%;
      max-width: 1024px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 32px 16px;
      border-radius: 16px;
    }

    .sheet-preview {
      background: var(--bg);
      padding: 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .sheet-title {
      font-size: 0.85rem;
      font-weight: bold;
      margin-bottom: 12px;
      color: var(--text);
    }

    .box-preview-box {
      width: 100%;
      height: 350px;
      background: var(--card-bg);
      border: 2px dashed var(--brand);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .box-preview-img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .placeholder {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-align: center;
      padding: 20px;
    }

    #printScreen {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: white;
      z-index: 9999;
      padding: 10px;
      overflow: auto;
    }

    @media print {
      @page {
        size: A4 landscape;
        margin: 0 !important;
      }
      html, body {
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
      }
      .ui-container, .preview-wrapper, header, footer, .no-print {
        display: none !important;
      }
      #printScreen {
        display: block !important;
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
      }
      .print-sheet {
        width: 297mm !important;
        height: 210mm !important;
        position: relative !important;
        page-break-after: always !important;
        break-after: page !important;
        background: white !important;
        overflow: hidden !important;
      }
      .print-box-img {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important;
      }
    }
  </style>
</head>
<body>

  <header>
    <a href="../../index.html" class="btn-index">
      <i class="fa-solid fa-arrow-left"></i>
      <span data-i18n="nav_index">Zurück zur Übersicht</span>
    </a>

    <a href="#" class="brand-title">
      <i class="fa-solid fa-box text-orange-400"></i>
      <div>
        <div style="font-weight: 800; font-size: 1rem;">PHYSICAL RELEASE</div>
        <div style="font-size: 0.7rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">Box & Inlay Studio <p>&copy; 2026 KainCo.</p></div>
      </div>
    </a>

    <div class="header-actions">
      <div class="lang-switcher">
        <button id="lang-en" onclick="setLanguage('en')" class="lang-btn">EN</button>
        <button id="lang-de" onclick="setLanguage('de')" class="lang-btn active">DE</button>
      </div>
    </div>
  </header>

  <div class="ui-container">
    <div class="header-title" data-i18n="studio_title">PC Big Box & Inlay Studio</div>
    <div class="sub-title" data-i18n="studio_subtitle">Erstelle klassische oder moderne Box-Schablonen für den Heimdrucker</div>

    <!-- Mode Selection -->
    <div class="option-card" style="border-color: var(--brand);">
      <label for="boxModeSelect"><span data-i18n="lbl_box_mode">📦 Box-Modus wählen:</span></label>
      <select id="boxModeSelect" onchange="updateStudio()">
        <option value="classic" selected data-i18n="opt_mode_classic">Klassische Big Box (Multi-Page Tiling auf A4 - 2 Blätter)</option>
        <option value="modern" data-i18n="opt_mode_modern">Moderne Mini-PC-Big-Box (1 DIN A4 Blatt für Jewel-Case)</option>
      </select>
    </div>

    <!-- Upload Layout / Net -->
    <div class="option-card">
      <label for="boxImageInput"><i class="fa-solid fa-image text-brand-accent"></i> <span data-i18n="lbl_upload">Box-Netz / Cover-Grafik hochladen:</span></label>
      <input type="file" id="boxImageInput" accept="image/*" onchange="loadBoxImage(event)">
    </div>

    <!-- Inlay Option -->
    <div class="option-card">
      <label class="checkbox-label">
        <input type="checkbox" id="includeInlay" checked onchange="updateStudio()">
        <span data-i18n="opt_inlay">Faltbares Innen-Inlay (gegen Verrutschen der CD) generieren</span>
      </label>
    </div>

    <button class="btn-print" onclick="preparePrint()" data-i18n="btn_print_box">🖨️ Box-Schablone drucken / Als PDF speichern</button>
  </div>

  <!-- Preview Wrapper -->
  <div class="preview-wrapper" id="preview-wrapper">
    <!-- Dynamische Vorschau wird hier generiert -->
  </div>

  <!-- Print Screen -->
  <div id="printScreen">
    <div style="padding: 10px; text-align: center; background: #f3f4f6; margin-bottom: 10px; display: flex; justify-content: center; gap: 12px;" class="no-print">
      <button onclick="window.print()" style="padding: 10px 20px; background: #10b981; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;" data-i18n="btn_print_now">Jetzt drucken / PDF speichern</button>
      <button onclick="closePrint()" style="padding: 10px 20px; background: #6b7280; color: white; border: none; border-radius: 6px; cursor: pointer;" data-i18n="btn_close">Schließen</button>
    </div>
    <div id="print-container"></div>
  </div>

  <script>
    const i18n = {
      en: {
        nav_index: "Back to Overview",
        studio_title: "PC Big Box & Inlay Studio",
        studio_subtitle: "Create classic or modern box templates for home printing",
        lbl_box_mode: "📦 Select Box Mode:",
        opt_mode_classic: "Classic Big Box (Multi-Page Tiling on A4 - 2 Sheets)",
        opt_mode_modern: "Modern Mini PC Big Box (1 A4 Sheet for Jewel Case)",
        lbl_upload: "Upload Box Net / Cover Artwork:",
        opt_inlay: "Generate Foldable Inner Inlay (prevents CD shifting)",
        btn_print_box: "🖨️ Print Box Template / Save as PDF",
        btn_print_now: "Print Now / Save PDF",
        btn_close: "Close",
        ph_upload: "Please upload a box net or artwork above.",
        sheet_1: "Sheet 1: Front / Left Flaps",
        sheet_2: "Sheet 2: Back / Right Flaps & Glue Tabs",
        sheet_inlay: "Sheet 3: Foldable Inner Inlay (Jewel Case Holder)",
        sheet_single: "Sheet 1: Complete Mini Box Net",
        alert_no_image: "Please upload an image file first!"
      },
      de: {
        nav_index: "Zurück zur Übersicht",
        studio_title: "PC Big Box & Inlay Studio",
        studio_subtitle: "Erstelle klassische oder moderne Box-Schablonen für den Heimdrucker",
        lbl_box_mode: "📦 Box-Modus wählen:",
        opt_mode_classic: "Klassische Big Box (Multi-Page Tiling auf A4 - 2 Blätter)",
        opt_mode_modern: "Moderne Mini-PC-Big-Box (1 DIN A4 Blatt für Jewel-Case)",
        lbl_upload: "Box-Netz / Cover-Grafik hochladen:",
        opt_inlay: "Faltbares Innen-Inlay (gegen Verrutschen der CD) generieren",
        btn_print_box: "🖨️ Box-Schablone drucken / Als PDF speichern",
        btn_print_now: "Jetzt drucken / PDF speichern",
        btn_close: "Schließen",
        ph_upload: "Bitte lade oben ein Box-Netz oder Artwork hoch.",
        sheet_1: "Blatt 1: Vorderseite / Linke Laschen",
        sheet_2: "Blatt 2: Rückseite / Rechte Laschen & Klebeflächen",
        sheet_inlay: "Blatt 3: Faltbares Innen-Inlay (Jewel-Case-Halterung)",
        sheet_single: "Blatt 1: Komplettes Mini-Box-Netz",
        alert_no_image: "Bitte lade zuerst eine Bilddatei hoch!"
      }
    };

    let currentLang = localStorage.getItem('prs_lang') || 'de';
    let uploadedImageSrc = null;

    function setLanguage(lang) {
      currentLang = lang;
      localStorage.setItem('prs_lang', lang);
      document.getElementById('lang-en').classList.toggle('active', lang === 'en');
      document.getElementById('lang-de').classList.toggle('active', lang === 'de');
      document.documentElement.lang = lang;

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18n[lang][key]) el.textContent = i18n[lang][key];
      });
      updateStudio();
    }

    function loadBoxImage(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          uploadedImageSrc = event.target.result;
          updateStudio();
        };
        reader.readAsDataURL(file);
      }
    }

    function updateStudio() {
      const previewWrapper = document.getElementById('preview-wrapper');
      previewWrapper.innerHTML = '';
      const mode = document.getElementById('boxModeSelect').value;
      const includeInlay = document.getElementById('includeInlay').checked;

      let sheets = [];
      if (mode === 'classic') {
        sheets.push(i18n[currentLang].sheet_1);
        sheets.push(i18n[currentLang].sheet_2);
        if (includeInlay) sheets.push(i18n[currentLang].sheet_inlay);
      } else {
        sheets.push(i18n[currentLang].sheet_single);
        if (includeInlay) sheets.push(i18n[currentLang].sheet_inlay);
      }

      sheets.forEach((titleText, idx) => {
        const sheetDiv = document.createElement('div');
        sheetDiv.className = 'sheet-preview';

        const title = document.createElement('div');
        title.className = 'sheet-title';
        title.innerText = titleText;
        sheetDiv.appendChild(title);

        const box = document.createElement('div');
        box.className = 'box-preview-box';

        if (uploadedImageSrc) {
          box.innerHTML = `<img src="${uploadedImageSrc}" class="box-preview-img" alt="Box Preview">`;
        } else {
          box.innerHTML = `<div class="placeholder"><i class="fa-solid fa-cloud-arrow-up text-2xl mb-2 text-brand"></i><br>${i18n[currentLang].ph_upload}</div>`;
        }

        sheetDiv.appendChild(box);
        previewWrapper.appendChild(sheetDiv);
      });
    }

    function preparePrint() {
      if (!uploadedImageSrc) {
        alert(i18n[currentLang].alert_no_image);
        return;
      }

      const mode = document.getElementById('boxModeSelect').value;
      const includeInlay = document.getElementById('includeInlay').checked;
      const printContainer = document.getElementById('print-container');
      printContainer.innerHTML = '';

      let sheets = [];
      if (mode === 'classic') {
        sheets.push(i18n[currentLang].sheet_1);
        sheets.push(i18n[currentLang].sheet_2);
        if (includeInlay) sheets.push(i18n[currentLang].sheet_inlay);
      } else {
        sheets.push(i18n[currentLang].sheet_single);
        if (includeInlay) sheets.push(i18n[currentLang].sheet_inlay);
      }

      sheets.forEach(titleText => {
        const sheet = document.createElement('div');
        sheet.className = 'print-sheet';
        sheet.innerHTML = `
          <div style="position: absolute; top: 10mm; left: 10mm; font-family: monospace; font-size: 10px; color: #666;">Physical Release Studio - ${titleText}</div>
          <img src="${uploadedImageSrc}" class="print-box-img" style="padding: 20mm;">
        `;
        printContainer.appendChild(sheet);
      });

      document.getElementById('printScreen').style.display = 'block';
    }

    function closePrint() {
      document.getElementById('printScreen').style.display = 'none';
    }

    window.onload = () => {
      setLanguage(currentLang);
    };
  </script>
</body>
</html>
